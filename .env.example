# Variables de entorno del proyecto smartradingreview
# Copiar este archivo a .env y rellenar con tus credenciales reales
# El archivo .env está en .gitignore y NO se sube a GitHub

# Supabase (crea tu proyecto en https://supabase.com)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=sb_secret_tu_clave_secreta_aqui

# Autenticación de endpoints protegidos (opcional)
SCHEDULED_AUTH_KEY=crypto_trader_analyst_2025

# IA operativa (chat/consejos)
GROQ_API_KEY=gsk_clave_groq_operativa

# Científico de aprendizaje (Commit 10)
# Opción recomendada a futuro: clave Groq dedicada.
GROQ_LEARNING_API_KEY=
GROQ_LEARNING_MODEL=

# Compatibilidad con el despliegue actual:
# - Si GEMINI_API_KEY contiene una clave Google, usa Gemini.
# - Si contiene una clave Groq que empieza por gsk_, usa Groq Learning.
#   El nombre se conserva para no obligar a renombrar la variable en Render ahora.
GEMINI_API_KEY=
GEMINI_LEARNING_ENABLED=true
GEMINI_LEARNING_MODEL=gemini-3.7-flash

# Commit 10.1 — protección de memoria para Render Free (~512 MB)
# Limita arenas glibc para reducir fragmentación de memoria en procesos con threads.
MALLOC_ARENA_MAX=1
# Los defaults del código son conservadores; sólo definir si necesitas ajustar.
MEMORY_SOFT_LIMIT_MB=250
MEMORY_HARD_LIMIT_MB=340
MEMORY_JOB_START_LIMIT_MB=240
MEMORY_ANALYSIS_CACHE_KEEP=2
FUTURES_DATA_CACHE_MAX_ENTRIES=2
LOW_MEMORY_MODE=1
FUTURES_INCREMENTAL_INTERVAL_SECONDS=60
FUTURES_INCREMENTAL_START_DELAY_SECONDS=180

# V1.0 Macro Context Radar — fuentes públicas, sin API key
MACRO_CONTEXT_ENABLED=true
MACRO_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires
MACRO_NEWS_CACHE_SECONDS=900
MACRO_CALENDAR_CACHE_SECONDS=21600
MACRO_NEWS_MAX_ARTICLES=12
MACRO_HTTP_TIMEOUT=7
MACRO_TELEGRAM_ALERTS_ENABLED=true

# Hotfix 14.6 — Analytics usa snapshot Supabase para no recalcular al abrir la pestaña
ANALYTICS_SNAPSHOT_FRESH_SECONDS=1800

# Hotfix 14.8 — Render safe boot
PYTHONUNBUFFERED=1
RUNTIME_BOOTSTRAP_DELAY_SECONDS=30

# Commit 15 — bounded research universe / microstructure
C15_RESEARCH_SHADOW_ENABLED=1
FUTURES_MICROSTRUCTURE_TTL_SECONDS=30

# Hotfix 15.1 — prioridad de usuario sobre research Futures incremental
FUTURES_UI_CACHE_TTL_SECONDS=90

# Hotfix 15.2 — cooperative learning / interactive Futures priority
LEARNING_MICROBATCH_ROWS=16
LEARNING_MICROBATCH_BUDGET_SECONDS=8
LEARNING_MICROBATCHES_PER_CYCLE=4
LEARNING_UI_YIELD_RETRY_SECONDS=60
FUTURES_INTERACTIVE_PRIORITY_SECONDS=45

# Hotfix 15.3 — prioridad UI y background austero
SYSTEM_INTERACTIVE_PRIORITY_SECONDS=60
FUTURES_INCREMENTAL_INTERVAL_SECONDS=60
FUTURES_SNAPSHOT_MIN_INTERVAL_SECONDS=120
LEARNING_MICROBATCH_ROWS=8
LEARNING_MICROBATCH_BUDGET_SECONDS=6
LEARNING_MICROBATCHES_PER_CYCLE=1

# Commit 16 · enlaces Telegram
PUBLIC_APP_URL=https://smartradingreview.onrender.com
RESEARCH_SHADOW_CANDIDATE_TTL_SECONDS=600

# Hotfix 16.1 — deja respiración entre jobs de fondo sin demorar la UI
BACKGROUND_HEAVY_COOLDOWN_SECONDS=20

# Hotfix 16.2 — Research Bridge server-side (NO exponer al navegador)
CENTRAL_SUPABASE_URL=https://tu-proyecto.supabase.co
CENTRAL_SUPABASE_SERVICE_KEY=sb_secret_service_role_backend
RESEARCH_BRIDGE_CACHE_SECONDS=60

# Hotfix 16.2 — operabilidad
BACKGROUND_HEAVY_COOLDOWN_SECONDS=20
